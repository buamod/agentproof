{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "vitest/globals"
    ],
    "noEmit": true,
    "moduleResolution": "bundler"
  },
  "include": [
    "packages/**/*",
    "tests/**/*",
    "scripts/**/*",
    "*.ts",
    "*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
