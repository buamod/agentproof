{
  "name": "agentproof",
  "version": "0.1.0",
  "description": "Deterministic, evidence-based security verification for AI agents",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "benchmark": "tsx scripts/benchmark.ts",
    "check:hermetic": "tsx scripts/check-hermetic.ts",
    "check:contracts": "tsx scripts/verify-contracts.ts",
    "test:coverage": "vitest run --coverage",
    "benchmark:json": "tsx scripts/benchmark.ts --json",
    "verify": "pnpm check:hermetic && pnpm check:contracts && pnpm check:workflows && pnpm typecheck && pnpm test:security && pnpm test && pnpm benchmark",
    "check:workflows": "tsx scripts/check-workflow-security.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
